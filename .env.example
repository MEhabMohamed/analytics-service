# HTTP server
PORT=5000
ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<db_username>:<db_password>@quickbite.nlf5hj9.mongodb.net/
MONGO_DB=quickbite_analytics
MONGO_USER=your_mongo_user
MONGO_PASS=your_mongo_password

# RabbitMQ — inbound order/payment events from order-service
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_ORDER_EVENTS_EXCHANGE=order.events
RABBITMQ_ORDER_EVENTS_QUEUE=analytics-service.order-events
RABBITMQ_ORDER_EVENTS_BINDINGS=order.#,payment.#
RABBITMQ_ORDER_EVENTS_DLX=order.events.dlx
RABBITMQ_ORDER_EVENTS_DLQ=analytics-service.order-events.dlq

# RabbitMQ — inbound RBAC invalidation events from core-service
RABBITMQ_CORE_EVENTS_EXCHANGE=core.events
RABBITMQ_CORE_EVENTS_QUEUE=analytics-service.core-events
RABBITMQ_CORE_EVENTS_BINDINGS=rbac.#
RABBITMQ_CORE_EVENTS_DLX=core.events.dlx
RABBITMQ_CORE_EVENTS_DLQ=analytics-service.core-events.dlq
RABBITMQ_PREFETCH=32

# Auth (must match core-service & order-service)
ACCESS_SECRET=super-secret-jwt-key-change-me
INTERNAL_API_KEY=internal-secret-api-key

# Core-service sync client (for RBAC permission lookup)
CORE_SERVICE_BASE_URL=http://localhost:3001
CORE_INTERNAL_API_KEY=internal-secret-api-key
RBAC_CACHE_TTL_SEC=300

# Optional backfill shard DSNs (comma-separated region=dsn pairs)
BACKFILL_PG_URLS=


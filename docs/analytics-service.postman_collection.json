              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/platform/failures?from={{from}}&to={{to}}&region={{region}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "platform", "failures"],
              "query": [
                { "key": "from", "value": "{{from}}" },
